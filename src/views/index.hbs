<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eef1f5" />
    <meta
      name="description"
      content="Foster: encontre estabelecimentos, consulte informações e visualize sua localização no mapa."
    />
    <title>Foster | Encontre estabelecimentos</title>

    <link rel="icon" href="/images/logo-icon.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/animations.css" />
    <link rel="stylesheet" href="/css/page-landing.css" />

    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div vw class="enabled">
      <div vw-access-button class="active"></div>
      <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
      </div>
    </div>

    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
      new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>

    <div id="page-landing">
      <div class="landing-shell">
        <header class="landing-header">
          <a href="/" class="brand animate-up" aria-label="Foster - Página inicial">
            <img id="logo" src="/images/logo-icon.png" alt="" aria-hidden="true" />
            <span>FOSTER</span>
          </a>

          <p class="header-description animate-up">
            Encontre estabelecimentos, consulte informações e veja sua localização.
          </p>
        </header>

        <main class="landing-main">
          <section class="hero" aria-labelledby="hero-title">
            <div class="hero-content">
              <span class="eyebrow animate-up">ENCONTRE · CONSULTE · LOCALIZE</span>

              <h1 id="hero-title" class="animate-up">
                Encontre o lugar certo para você.
              </h1>

              <p class="hero-description animate-up">
                O Foster reúne estabelecimentos cadastrados em um único catálogo,
                com informações úteis e localização no mapa.
              </p>

              <a
                href="/stores"
                class="hero-action animate-up"
                title="Explorar estabelecimentos"
              >
                <span>Explorar estabelecimentos</span>
                <img src="/images/arrow.svg" alt="" aria-hidden="true" />
              </a>
            </div>

            <div class="hero-visual animate-up">
              <img
                src="/images/bg.svg"
                alt="Ilustração de prédios representando estabelecimentos"
                class="city-illustration"
              />
            </div>
          </section>

          <section class="features" aria-label="Recursos do Foster">
            <article class="feature animate-up">
              <span class="feature-number">01</span>
              <div>
                <h2>Estabelecimentos</h2>
                <p>Consulte os negócios cadastrados no catálogo.</p>
              </div>
            </article>

            <article class="feature animate-up">
              <span class="feature-number">02</span>
              <div>
                <h2>Informações</h2>
                <p>Acesse contato, horários, imagens e detalhes do local.</p>
              </div>
            </article>

            <article class="feature animate-up">
              <span class="feature-number">03</span>
              <div>
                <h2>Localização</h2>
                <p>Visualize onde cada estabelecimento está no mapa.</p>
              </div>
            </article>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
