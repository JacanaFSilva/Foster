<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eef1f5" />
    <meta
      name="description"
      content="Foster: encontre estabelecimentos, consulte informações e visualize sua localização no mapa."
    />
    <title>Foster | Encontre estabelecimentos</title>

    <link rel="icon" href="/images/logo-icon.png" />

    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/animations.css" />
    <link rel="stylesheet" href="/css/page-landing.css" />

    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div vw class="enabled">
      <div vw-access-button class="active"></div>
      <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
      </div>
    </div>

    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
      new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>

    <div id="page-landing">
      <div id="container">
        <header>
          <a href="/" class="brand animate-up" aria-label="Foster - Página inicial">
            <img id="logo" src="/images/logo.svg" alt="" aria-hidden="true" />
            <span>FOSTER</span>
          </a>

          <div class="location animate-up">
            <strong>Seu catálogo local</strong>
            <p>Estabelecimentos, informações e localização em um só lugar.</p>
          </div>
        </header>

        <main>
          <div class="hero-grid">
            <section class="hero-copy">
              <span class="eyebrow animate-up">ENCONTRE · CONSULTE · LOCALIZE</span>

              <h1 class="animate-up">
                Encontre estabelecimentos e descubra onde estão.
              </h1>

              <p class="description animate-up">
                O Foster reúne negócios cadastrados em um único lugar, com
                informações úteis para consultar antes de sair: horários,
                contato, imagens e localização no mapa.
              </p>

              <div class="highlights" aria-label="Recursos do Foster">
                <div class="highlight animate-up">
                  <strong>Catálogo</strong>
                  <span>Estabelecimentos cadastrados e organizados.</span>
                </div>

                <div class="highlight animate-up">
                  <strong>Informações</strong>
                  <span>Horários, contato, imagens e detalhes do local.</span>
                </div>

                <div class="highlight animate-up">
                  <strong>Mapa</strong>
                  <span>Veja a localização de cada estabelecimento.</span>
                </div>
              </div>

              <section class="visit animate-up">
                <div class="visit-content">
                  <div>
                    <span class="visit-label">COMECE PELO CATÁLOGO</span>
                    <p>Explore os estabelecimentos disponíveis e acesse os detalhes de cada local.</p>
                  </div>

                  <a
                    href="/stores"
                    title="Explorar estabelecimentos"
                    class="botaoAmarelo"
                    aria-label="Explorar estabelecimentos"
                  >
                    <span>Explorar estabelecimentos</span>
                    <img src="/images/arrow.svg" alt="" aria-hidden="true" />
                  </a>
                </div>
              </section>
            </section>

            <aside class="hero-visual" aria-label="Ilustração de estabelecimentos">
              <img
                class="city-illustration animate-up"
                src="/images/bg.svg"
                alt="Ilustração de prédios e estabelecimentos"
              />
              <span class="visual-caption animate-up">
                Negócios organizados para você encontrar, consultar e localizar.
              </span>
            </aside>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
